# LaMi Command Center — server-side secrets (never exposed to the client)

# Gemini API key for the Concierge AI endpoint (POST /api/concierge).
# Leave empty to gracefully disable AI replies (chat falls back to WhatsApp hand-off).
GEMINI_API_KEY=

# Google Sheets sync for the Finance ledger (POST /api/finance/sync).
# Service-account key JSON (single line) + target spreadsheet ID.
# Leave empty to keep finance data local-only.
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ——— Client-side soft-gate login (NOT a real secret) ———
# These VITE_ vars are inlined into the built client bundle, so anyone who
# loads the app can extract them. They only keep the credential out of the
# (public) source repo. Real protection is the Phase 2 Supabase auth.
# Leave unset to fall back to the built-in default gate.
VITE_APP_USER=
VITE_APP_PASSWORD=
# Optional WhatsApp integration (client-side tokens are public by design)
VITE_WHATSAPP_TOKEN=
VITE_WHATSAPP_PHONE_ID=
VITE_LAYLA_WHATSAPP=

# Optional analytics placeholders (template substitution)
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=

# Dev-only Manus storage proxy (dev tooling)
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Supabase (Phase 2 - server-side auth placeholders)
# Note: These are NOT used in current Phase 1 runtime — provided for future integration.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Database URL (if adopting server-side DB)
DATABASE_URL=

# Note: Do NOT commit a real .env with secrets. Use your deployment secret manager or CI variables.
