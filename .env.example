# LaMi Command Center — server-side secrets (never exposed to the client)

# Gemini API key for the Concierge AI endpoint (POST /api/concierge).
# Leave empty to gracefully disable AI replies (chat falls back to WhatsApp hand-off).
GEMINI_API_KEY=

# Google Sheets sync for the Finance ledger (POST /api/finance/sync).
# Service-account key JSON (single line) + target spreadsheet ID.
# Leave empty to keep finance data local-only.
GOOGLE_SHEETS_CREDENTIALS=
GOOGLE_SHEETS_SPREADSHEET_ID=

# ——— Client-side soft-gate login (NOT a real secret) ———
# These VITE_ vars are inlined into the built client bundle, so anyone who
# loads the app can extract them. They only keep the credential out of the
# (public) source repo. Real protection is the Phase 2 Supabase auth.
# Leave unset to fall back to the built-in default gate.
VITE_APP_USER=
VITE_APP_PASSWORD=
